# Hyrax Task Management - Environment Variables
# Copy this file to .env and update with your values

# API Configuration
VITE_API_BASE_URL=http://localhost:3001/api
VITE_USE_API=true
VITE_APP_TITLE=Hyrax Task Management
VITE_APP_VERSION=1.0.0

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
VITE_SESSION_TIMEOUT=24h

# Super Admin Credentials (fallback if users.json fails)
SUPER_ADMIN_EMAIL=admin@wearehyrax.com
SUPER_ADMIN_PASSWORD=HyraxAdmin2024!SecurePass
SUPER_ADMIN_NAME=HYRAX Super Admin

# Features
VITE_ENABLE_DEBUG=false
VITE_ENABLE_ANALYTICS=false

# Deployment
VITE_DEPLOYMENT_ENV=development

# Webhook Configuration
VITE_LOGIN_WEBHOOK_URL=your-login-webhook-url
VITE_GET_USERS_WEBHOOK_URL=https://workflows.wearehyrax.com/webhook/users-webhook
VITE_GET_CAMPAIGNS_WEBHOOK_URL=your-campaigns-webhook-url
VITE_TASKS_WEBHOOK_URL=your-tasks-webhook-url
VITE_NEW_CREATIVE_FROM_TASKS_WEBHOOK_URL=your-new-creative-from-tasks-webhook-url
VITE_TASKS_CREATIVE_APPROVED_WEBHOOK_URL=your-tasks-creative-approved-webhook-url
VITE_DOWNLOAD_CREATIVE_WEBHOOK_URL=your-download-creative-webhook-url

# S3-Compatible Storage Configuration (Cloudflare R2, AWS S3, etc.)
# Used to upload creative files (images, videos) to S3 instead of sending to n8n
# These match the exact fields needed in n8n S3 node
VITE_S3_ENDPOINT=https://your-endpoint.r2.cloudflarestorage.com
VITE_S3_REGION=auto
VITE_S3_ACCESS_KEY_ID=your-s3-access-key-id
VITE_S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
VITE_S3_BUCKET_NAME=creatives
VITE_S3_PUBLIC_URL=https://your-endpoint.r2.cloudflarestorage.com

# Optional: Backend endpoint for generating presigned URLs (RECOMMENDED for production)
# If provided, the app will use presigned URLs instead of direct upload
# This is more secure as it doesn't expose S3 credentials in the frontend
VITE_S3_PRESIGNED_URL_ENDPOINT=

# Note: For Vercel deployment, set JWT_SECRET and SUPER_ADMIN_* variables
# in the Vercel dashboard under Settings > Environment Variables